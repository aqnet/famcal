# Copy to .env.local and fill in. Never commit real values (the repo is public).

# Supabase (Project Settings → API). Publishable key is safe in the browser; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection for the famcal schema (Connect → Session pooler, port 5432).
# famcal is not exposed to the Data API, so the server reads it over Postgres, not supabase-js.
# Not the transaction pooler (6543): the server's pooled connections hung there.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32 random bytes, base64. Encrypts Google refresh tokens and signs the PIN cookie.
# Generate with: openssl rand -base64 32
FAMCAL_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Authorised redirect URI: <app origin>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SmugMug API key (public or unlisted galleries).
SMUGMUG_API_KEY=

# Optional: hosts allowed to use `next dev` from other devices on the LAN (comma-separated IPs)
DEV_ORIGINS=
